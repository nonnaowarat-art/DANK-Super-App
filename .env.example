# Neon PostgreSQL connection string
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (optional — needed for card payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── LINE Bot ─────────────────────────────────────────────────────────────────
# Get these from LINE Developers Console → Your Channel → Messaging API
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# Cron job secret — set this to any random string and use it in X-Cron-Secret header
CRON_SECRET="generate-a-random-secret-here"
