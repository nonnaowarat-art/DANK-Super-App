generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Float
  category    String
  imageUrl    String?
  tags        String      @default("")
  stock       Int         @default(0)
  strainType  String?
  thc         Float?
  cbd         Float?
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          String      @default("PENDING")
  fulfillment     String      @default("PICKUP")
  paymentMethod   String      @default("PAY_ON_PICKUP")
  paymentStatus   String      @default("COLLECT_ON_PICKUP")
  stripeSessionId String?
  customerName    String
  email           String
  phone           String
  address         String?
  notes           String?
  subtotal        Float
  tax             Float
  total           Float
  createdAt       DateTime    @default(now())
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

// ─── LINE Bot Models ───────────────────────────────────────────────

model LineGroup {
  id          String         @id @default(cuid())
  lineGroupId String         @unique
  name        String
  groupType   String         // STOCK_CHECK | KPI_SHIFT
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  stockEntries StockEntry[]
  shiftKPIs   ShiftKPI[]
  summaries   GroupSummary[]
}

model StockEntry {
  id           String    @id @default(cuid())
  groupId      String
  group        LineGroup @relation(fields: [groupId], references: [id])
  productName  String
  quantity     Int
  unit         String    @default("units")
  status       String    @default("OK") // OK | LOW | OUT
  notes        String?
  reportedBy   String
  reporterName String
  entryDate    DateTime  @default(now())
  createdAt    DateTime  @default(now())
}

model ShiftKPI {
  id            String    @id @default(cuid())
  groupId       String
  group         LineGroup @relation(fields: [groupId], references: [id])
  shiftDate     DateTime
  shiftType     String    @default("GENERAL") // MORNING | AFTERNOON | NIGHT | GENERAL
  staffName     String
  totalSales    Float     @default(0)
  customerCount Int       @default(0)
  topProducts   String?
  notes         String?
  rawMessage    String?   @db.Text
  createdAt     DateTime  @default(now())
}

model GroupSummary {
  id          String    @id @default(cuid())
  groupId     String
  group       LineGroup @relation(fields: [groupId], references: [id])
  summaryType String    // STOCK_DAILY | KPI_SHIFT
  summaryDate DateTime
  content     String    @db.Text
  sentToLine  Boolean   @default(false)
  createdAt   DateTime  @default(now())
}
